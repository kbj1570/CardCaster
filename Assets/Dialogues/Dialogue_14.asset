  m_Script: {fileID: 11500000, guid: 63270e1dec17bfc4a99b21cf610bba98, type: 3}
  m_Name: Dialogue_14
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uADF8 \uC560\uB97C \uBCF8 \uACF3\uC774 \uBD84\uBA85\uD788\n\uC5EC\uAE30\uC600\uC9C0?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uADF8\uB798. \uC6B0\uB9AC\uB97C \uBCF4\uACE0\uB294 \uC548 \uCABD\uC73C\uB85C\n\uB3C4\uB9DD\uCCE4\uC5C8\uC9C0."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uC548 \uCABD\uC5D4 \uAD34\uBB3C\uB4E4 \uD22C\uC131\uC77C\uD150\uB370.\n\uC65C
      \uADF8\uB807\uAC8C \uB3C4\uB9DD\uCE5C\uAC74\uC9C0.."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uADF8\uC57C \uBED4\uD558\uC9C0 \uBB50."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uC774\uB807\uAC8C \uB369\uCE58 \uD06C\uACE0\uB208\uC774 \uC2DC\uAEBC\uBA3C\n\uB291\uB300\uAC00
      \uBA40\uB9AC\uC11C \uB178\uB824\uBCF4\uB294\uB370."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uADF8 \uC5B4\uB9B0 \uC560\uAC00 \uBB34\uC11C\uC6CC\uC11C\n\uB3C4\uB9DD
      \uC548\uAC00\uACE0 \uBC30\uAE30\uACA0\uC5B4?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uD06C\uC73D."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uADF8\uAC70 \uB54C\uBB38\uC5D0 \uC6B8\uB9B0 \uC560\uB4E4\uB3C4 \n\uC9C0\uAE08\uAE4C\uC9C0
      \uD55C \uB458\uC774 \uC544\uB2C8\uC5C8\uC796\uC544?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uC544\uD508 \uACF3\uC744 \uCC0C\uB974\uB294\uAD6C\uB9CC."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uC7A1\uB2F4\uC740 \uC5EC\uAE30\uAE4C\uC9C0\uD558\uACE0 \uC5B4\uC11C \uAC00\uBCF4\uC790."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uC544\uC774\uAC00 \uBB34\uC0AC\uD558\uBA74 \uC88B\uC744\uD150\uB370."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: ......
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
