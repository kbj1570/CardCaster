  - portrait: {fileID: 21300000, guid: dbf85913df6f05c4db3e9465472d66d5, type: 3}
    background: {fileID: 0}
    speaker: 
    text: 
    choices: []
    lineEvent:
      eventType: 14
      parameter: "\uB108\uBB34 \uAC15\uD55C \uB9D0\uC740 \uC4F0\uC9C0 \uB9C8. \uC57D\uD574\uBCF4\uC778\uB2E4\uACE0.
        \uB3D9\uACBD\uC774\uB780 \uC774\uD574\uB85C\uBD80\uD130 \uAC00\uC7A5 \uBA3C
        \uAC10\uC815\uC774\uC57C. \uC5B8\uC131\uC744 \uC5B8\uC131\uC744 \uB192\uC774\uC9C0\uB9C8\uB77C.
        \uCFE0\uB85C\uC0AC\uD0A4 \uC774\uCE58\uACE0.\uAC10\uD788 \uB108\uD76C \uB530\uC704\uAC00
        \uB098\uC5D0\uAC8C \uD310\uACB0\uC744?\uAE68\uC838\uB77C, \uACBD\uD654\uC218\uC6D4.\uC5B8\uC81C\uBD80\uD130
        \uACBD\uD654\uC218\uC6D4\uC744 \uC4F0\uC9C0 \uC54A\uACE0\uC788\uB2E4\uACE0
        \uCC29\uAC01\uD55C\uAC70\uC9C0?\uC5B4\uC11C\uC640\uB77C. \uB098\uC758 \uC18C\uC6B8\uC18C\uC0AC\uC774\uC5B4\uD2F0\uC5D0.\uAE38\uACE0
        \uAE38\uC5C8\uB358 \uCC9C\uC88C\uC758 \uACF5\uBC31\uB3C4 \uC774\uC820 \uB05D\uC774\uB2E4.\uADF8\uB7EC\uB2C8\uAE4C.\uB0B4\uAC00
        \uD558\uB298\uC5D0 \uC11C\uACA0\uB2E4.\uB108\uBB34 \uAC15\uD55C \uB9D0\uC740
        \uC4F0\uC9C0 \uB9C8. \uC57D\uD574\uBCF4\uC778\uB2E4\uACE0. \uB3D9\uACBD\uC774\uB780
        \uC774\uD574\uB85C\uBD80\uD130 \uAC00\uC7A5 \uBA3C \uAC10\uC815\uC774\uC57C.
        \uC5B8\uC131\uC744. \uADF8\uB807\uAC8C \uC5B8\uC131\uC744 \uB192\uC774\uC9C0\uB9C8\uB77C.
        \uCFE0\uB85C\uC0AC\uD0A4 \uC774\uCE58\uACE0.\uAC10\uD788 \uB108\uD76C \uB530\uC704\uAC00
        \uB098\uC5D0\uAC8C \uD310\uACB0\uC744?\uAE68\uC838\uB77C, \uACBD\uD654\uC218\uC6D4.\uC5B8\uC81C\uBD80\uD130
        \uACBD\uD654\uC218\uC6D4\uC744 \uC4F0\uC9C0 \uC54A\uACE0\uC788\uB2E4\uACE0
        \uCC29\uAC01\uD55C\uAC70\uC9C0?\uC5B4\uC11C\uC640\uB77C. \uB098\uC758 \uC18C\uC6B8\uC18C\uC0AC\uC774\uC5B4\uD2F0\uC5D0.\uAE38\uACE0
        \uAE38\uC5C8\uB358 \uCC9C\uC88C\uC758 \uACF5\uBC31\uB3C4 \uC774\uC820 \uB05D\uC774\uB2E4.\uADF8\uB7EC\uB2C8\uAE4C.\uB0B4\uAC00
        \uD558\uB298\uC5D0 \uC11C\uACA0\uB2E4.\uB610 \uC0AC\uB78C\uC744 \uB54C\uB838\uB290\uB0D0?\uC544\uC2A4\uD1A0\uB77C.\uBAA8\uB450
        \uCE20\uD0A4\uC2DC\uB9C8\uC528\uAC00 \uC788\uC5C8\uAE30 \uB54C\uBB38\uC774\uC796\uC544!5\uBD84\uC548\uC5D0
        \uB05D\uB0B8\uB2E4.\uCC60\uB4DC\uC758 \uC601\uC555\uC774 \uC0AC\uB77C\uC84C\uB2E4?\uADF8
        \uB140\uC11D\uC740 \uC544\uB9C8 \uC6B0\uB9AC \uC911\uC5D0\uC11C \uAC00\uC7A5
        \uC5F0\uC57D\uD560\uAC70\uC57C.\uB108\uBB34 \uAC15\uD55C \uB9D0\uC740 \uC4F0\uC9C0
        \uB9C8. \uC57D\uD574\uBCF4\uC778\uB2E4\uACE0. \uB3D9\uACBD\uC774\uB780 \uC774\uD574\uB85C\uBD80\uD130
        \uAC00\uC7A5 \uBA3C \uAC10\uC815\uC774\uC57C. \uC5B8\uC131\uC744 \uC5B8\uC131\uC744
        \uB192\uC774\uC9C0\uB9C8\uB77C. \uCFE0\uB85C\uC0AC\uD0A4 \uC774\uCE58\uACE0.\uAC10\uD788
        \uB108\uD76C \uB530\uC704\uAC00 \uB098\uC5D0\uAC8C \uD310\uACB0\uC744?\uAE68\uC838\uB77C,
        \uACBD\uD654\uC218\uC6D4.\uC5B8\uC81C\uBD80\uD130 \uACBD\uD654\uC218\uC6D4\uC744
        \uC4F0\uC9C0 \uC54A\uACE0\uC788\uB2E4\uACE0 \uCC29\uAC01\uD55C\uAC70\uC9C0?\uC5B4\uC11C\uC640\uB77C.
        \uB098\uC758 \uC18C\uC6B8\uC18C\uC0AC\uC774\uC5B4\uD2F0\uC5D0.\uAE38\uACE0
        \uAE38\uC5C8\uB358 \uCC9C\uC88C\uC758 \uACF5\uBC31\uB3C4 \uC774\uC820 \uB05D\uC774\uB2E4.\uADF8\uB7EC\uB2C8\uAE4C.\uB0B4\uAC00
        \uD558\uB298\uC5D0 \uC11C\uACA0\uB2E4.\uB108\uBB34 \uAC15\uD55C \uB9D0\uC740
        \uC4F0\uC9C0 \uB9C8. \uC57D\uD574\uBCF4\uC778\uB2E4\uACE0. \uB3D9\uACBD\uC774\uB780
        \uC774\uD574\uB85C\uBD80\uD130 \uAC00\uC7A5 \uBA3C \uAC10\uC815\uC774\uC57C.
        \uC5B8\uC131\uC744. \uADF8\uB807\uAC8C \uC5B8\uC131\uC744 \uB192\uC774\uC9C0\uB9C8\uB77C.
        \uCFE0\uB85C\uC0AC\uD0A4 \uC774\uCE58\uACE0.\uAC10\uD788 \uB108\uD76C \uB530\uC704\uAC00
        \uB098\uC5D0\uAC8C \uD310\uACB0\uC744?\uAE68\uC838\uB77C, \uACBD\uD654\uC218\uC6D4.\uC5B8\uC81C\uBD80\uD130
        \uACBD\uD654\uC218\uC6D4\uC744 \uC4F0\uC9C0 \uC54A\uACE0\uC788\uB2E4\uACE0
        \uCC29\uAC01\uD55C\uAC70\uC9C0?\uC5B4\uC11C\uC640\uB77C. \uB098\uC758 \uC18C\uC6B8\uC18C\uC0AC\uC774\uC5B4\uD2F0\uC5D0.\uAE38\uACE0
        \uAE38\uC5C8\uB358 \uCC9C\uC88C\uC758 \uACF5\uBC31\uB3C4 \uC774\uC820 \uB05D\uC774\uB2E4.\uADF8\uB7EC\uB2C8\uAE4C.\uB0B4\uAC00
        \uD558\uB298\uC5D0 \uC11C\uACA0\uB2E4.\uB610 \uC0AC\uB78C\uC744 \uB54C\uB838\uB290\uB0D0?\uC544\uC2A4\uD1A0\uB77C.\uBAA8\uB450
        \uCE20\uD0A4\uC2DC\uB9C8\uC528\uAC00 \uC788\uC5C8\uAE30 \uB54C\uBB38\uC774\uC796\uC544!5\uBD84\uC548\uC5D0
        \uB05D\uB0B8\uB2E4.\uCC60\uB4DC\uC758 \uC601\uC555\uC774 \uC0AC\uB77C\uC84C\uB2E4?\uADF8
        \uB140\uC11D\uC740 \uC544\uB9C8 \uC6B0\uB9AC \uC911\uC5D0\uC11C \uAC00\uC7A5
        \uC5F0\uC57D\uD560\uAC70\uC57C.\n\n\n\n\t\t\t\t-\uB9CC\uC2E0 \uCFE0\uBCF4-"
