  - mugShot: {fileID: -6382524348662822855, guid: f06b233c95fa86c4585f2e89c9a080a5, type: 3}
    speaker: 
    text: "\uC788\uC796\uC544. \uD639\uC2DC...."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - mugShot: {fileID: 21300000, guid: dbf85913df6f05c4db3e9465472d66d5, type: 3}
    speaker: 
    text: "\uC808\uB300 \uC548\uB3FC."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - mugShot: {fileID: -6382524348662822855, guid: f06b233c95fa86c4585f2e89c9a080a5, type: 3}
    speaker: 
    text: "\uC544\uC9C1 \uB9D0\uB3C4 \uC548 \uAEBC\uB0C8\uAC70\uB4E0!"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - mugShot: {fileID: 21300000, guid: dbf85913df6f05c4db3e9465472d66d5, type: 3}
    speaker: 
    text: "\uB124\uAC00 \uBB34\uC2A8 \uB9D0\uC744 \uD560\uC9C0\uC57C \uBED4\uD558\uC9C0."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - mugShot: {fileID: 21300000, guid: dbf85913df6f05c4db3e9465472d66d5, type: 3}
    speaker: 
    text: "\uC6B0\uB9AC\uAC00 \uB3C4\uB451\uB3C4 \uC544\uB2C8\uACE0."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - mugShot: {fileID: 21300000, guid: dbf85913df6f05c4db3e9465472d66d5, type: 3}
    speaker: 
    text: "\uC8FC\uC778\uC774 \uC788\uC744\uC9C0\uB3C4 \uBAA8\uB974\uB294\uB370 \uB0A8\uC758
      \uAC78 \uBA4B\uB300\uB85C \uBA39\uC744 \uC218\uB294 \uC5C6\uC796\uC544."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - mugShot: {fileID: -6382524348662822855, guid: f06b233c95fa86c4585f2e89c9a080a5, type: 3}
    speaker: 
    text: "\uADF8\uCE58\uB9CC. \uC624\uB298 \uD558\uB8E8\uC885\uC77C \uC544\uBB34\uAC83\uB3C4
      \uBABB \uBA39\uC5C8\uB2E8 \uB9D0\uC774\uC57C..."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - mugShot: {fileID: -6382524348662822855, guid: f06b233c95fa86c4585f2e89c9a080a5, type: 3}
    speaker: 
    text: "\uC544\uC8FC \uC870\uAE08\uB9CC...  \uC751?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - mugShot: {fileID: 21300000, guid: dbf85913df6f05c4db3e9465472d66d5, type: 3}
    speaker: 
    text: "(\uC61B\uB0A0\uBD80\uD130 \uC800 \uB208\uBE5B\uC744 \uBCF4\uBA74 \uC660\uC9C0\\r\\n\uAC70\uC808\uD558\uAE30\uAC00
      \uD798\uB4E4\uC5B4\uC9C4\uB2E4.)"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - mugShot: {fileID: 21300000, guid: dbf85913df6f05c4db3e9465472d66d5, type: 3}
    speaker: 
    text: "(\uC544\uBB34\uB798\uB3C4 \uBC30\uAC00 \uB9CE\uC774 \uACE0\uD508 \uBAA8\uC591\uC778\uB370.)"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - mugShot: {fileID: 21300000, guid: dbf85913df6f05c4db3e9465472d66d5, type: 3}
    speaker: 
    text: "(\uC774\uB807\uAC8C \uC2A4\uD504\uAC00 \uB9CE\uC774 \uC788\uC73C\uBA74
      \uC0D0\uB9AC\uC628\uC774 \uBA39\uC744\uB9CC\uD07C\uB9CC \uCC59\uACA8\uB3C4
      \uBCC4\uB85C \uD2F0\uAC00 \uB098\uC9C0\uB294 \uC54A\uC744\uAC70\uC57C.)"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - mugShot: {fileID: 21300000, guid: dbf85913df6f05c4db3e9465472d66d5, type: 3}
    speaker: 
    text: "(\uADF8\uB798\uB3C4... \uC5B4\uB5A1\uD558\uC9C0?)"
    choices:
    - choiceText: "\uC5B4\uCA54\uC218 \uC5C6\uC9C0."
      nextDialogueIndex: 24
      choiceEvent:
        eventType: 0
        parameter: 
    - choiceText: "\uADF8\uB798\uB3C4 \uC548\uB3FC."
      nextDialogueIndex: 38
      choiceEvent:
        eventType: 0
        parameter: 
    lineEvent:
      eventType: 0
      parameter: 
  - mugShot: {fileID: 21300000, guid: dbf85913df6f05c4db3e9465472d66d5, type: 3}
    speaker: 
    text: "\uC5B4\uCA54 \uC218 \uC5C6\uC9C0.\\r\\n\uADF8\uB7FC \uC544\uC8FC \uC870\uAE08\uB9CC\uC774\uB2E4."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - mugShot: {fileID: -6382524348662822855, guid: f06b233c95fa86c4585f2e89c9a080a5, type: 3}
    speaker: 
    text: "\uC624\uC608! \uACE0\uB9C8\uC6CC!"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - mugShot: {fileID: -6382524348662822855, guid: f06b233c95fa86c4585f2e89c9a080a5, type: 3}
    speaker: 
    text: "\uADF8\uB7F0\uB370 \uC544\uBB34\uB798\uB3C4 \uC774 \uC2A4\uD504..."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - mugShot: {fileID: -6382524348662822855, guid: f06b233c95fa86c4585f2e89c9a080a5, type: 3}
    speaker: 
    text: "\uB9CC\uB4E4\uB2E4\uAC00 \uB9D0\uC740 \uAC83 \uAC19\uC740\uB370?\\r\\n\uC606\uC5D0
      \uC788\uB294 \uAC00\uBC29\uC5D0 \uC7AC\uB8CC\uB4E4\uC774 \uC794\uB729 \uC788\uC5B4."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - mugShot: {fileID: 21300000, guid: dbf85913df6f05c4db3e9465472d66d5, type: 3}
    speaker: 
    text: "\uBB54\uC9C0\uB294 \uC798 \uBAA8\uB974\uACA0\uC9C0\uB9CC... \\r\\n\uC544\uBB34\uD2BC
      \uB123\uC5B4\uBCFC\uAE4C?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - mugShot: {fileID: -6382524348662822855, guid: f06b233c95fa86c4585f2e89c9a080a5, type: 3}
    speaker: 
    text: "\uC88B\uC544! \uADF8\uB7FC \uB9CC\uB4E4\uC5B4\uBCF4\uC790\uACE0!"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - mugShot: {fileID: 0}
    speaker: 
    text: "\uC0DB\uB178\uB780 \uC2A4\uD504\uAC00 \uBD80\uAE00\uBD80\uAE00 \uB053\uACE0
      \uC788\uB2E4."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - mugShot: {fileID: 0}
    speaker: 
    text: "\uC77C\uB2E8 \uBA3C\uC800 \uB123\uC744 \uC7AC\uB8CC\uB294..."
    choices:
