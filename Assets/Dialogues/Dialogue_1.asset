      parameter: 
  - mugShot: {fileID: -6382524348662822855, guid: f06b233c95fa86c4585f2e89c9a080a5, type: 3}
    speaker: 
    text: "\uB108\uB3C4 \uB9E1\uC558\uC9C0? \uBB54\uAC00 \uB9DB\uC788\uB294 \uB0C4\uC0C8\uAC00
      \uB098\uC796\uC544!"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - mugShot: {fileID: 21300000, guid: dbf85913df6f05c4db3e9465472d66d5, type: 3}
    speaker: 
    text: "\uC544\uBB34\uB798\uB3C4 \uC800\uAC70\uC778 \uAC83 \uAC19\uC740\uB370."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - mugShot: {fileID: -6382524348662822855, guid: f06b233c95fa86c4585f2e89c9a080a5, type: 3}
    speaker: 
    text: "\uC5B4\uB77C?"
