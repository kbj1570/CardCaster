  lines:
  - speaker: "\uC0D0\uB9AC\uC628"
    text: "\uC751?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - speaker: "\uC0D0\uB9AC\uC628"
    text: "\uBB34\uC2A8 \uB0C4\uC0C8\uC9C0?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - speaker: "\uC0D0\uB9AC\uC628"
    text: " \uB108\uB3C4 \uB9E1\uC558\uC9C0? \uBB54\uAC00 \uB9DB\uC788\uB294 \uB0C4\uC0C8\uAC00
      \uB098\uC796\uC544?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - speaker: "\uD06C\uB9AC\uC2A4"
    text: "\uC800\uAE30\uC11C \uB098\uB294 \uAC83 \uAC19\uC740\uB370."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - speaker: "\uC0D0\uB9AC\uC628"
    text: "\uC751?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - speaker: "\uC0D0\uB9AC\uC628"
    text: "\uB0C4\uBE44?"
    choices: []
    lineEvent:
      eventType: 5
      parameter: "\uB3CC\uBC1C\uC0C1\uD669 #1 \uC990\uAC70\uC6B4? \uC694\uB9AC\uC2DC\uAC04"
  - speaker: "\uD06C\uB9AC\uC2A4"
    text: "\uB0C4\uBE44\uB85C\uAD70."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - speaker: "\uD06C\uB9AC\uC2A4"
    text: "\uAC8C\uB2E4\uAC00 \uB2E4\uB978 \uC2DD\uC7AC\uB8CC\uB4E4\uC774 \uC794\uB729
      \uC788\uC5B4."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - speaker: "\uC0D0\uB9AC\uC628"
    text: "\uB204\uAD70\uAC00\uAC00 \uB450\uACE0 \uAC04 \uAC78\uAE4C?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - speaker: "\uD06C\uB9AC\uC2A4"
    text: "\uC544\uC9C1 \uADFC\uCC98\uC5D0 \uC8FC\uC778\uC774 \uC788\uC744\uC9C0\uB3C4
      \uBAA8\uB974\uC9C0"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - speaker: "\uC0D0\uB9AC\uC628"
    text: "\uC544\uB2C8\uBA74 \uAD34\uBB3C\uC744 \uBCF4\uACE0 \uB3C4\uB9DD\uAC14\uAC70\uB098.
      \uADF8\uCE58?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - speaker: "\uC0D0\uB9AC\uC628"
    text: "\uC788\uC796\uC544. \uD639\uC2DC..."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - speaker: "\uD06C\uB9AC\uC2A4"
    text: "\uC808\uB300 \uC548\uB3FC."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - speaker: "\uC0D0\uB9AC\uC628"
    text: "\uC544\uC9C1 \uB9D0\uB3C4 \uC548\uD588\uAC70\uB4E0!!"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - speaker: "\uD06C\uB9AC\uC2A4"
    text: "\uC544\uBB34\uB9AC \uADF8\uB798\uB3C4 \uB0A8\uC758 \uAC78 \uBA4B\uB300\uB85C
      \uBA39\uC5B4\uBC84\uB9AC\uBA74 \uC548\uB418\uC9C0."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - speaker: "\uD06C\uB9AC\uC2A4"
    text: "\uC6B0\uB9AC\uAC00 \uAC15\uB3C4\uB294 \uC544\uB2C8\uC796\uC544?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - speaker: "\uC0D0\uB9AC\uC628"
    text: "\uADF8\uCE58\uB9CC... \uC624\uB298 \uD558\uB8E8\uC885\uC77C \uC544\uBB34\uAC83\uB3C4
      \uBABB \uBA39\uC5C8\uB2E4\uACE0..."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - speaker: "\uD06C\uB9AC\uC2A4"
    text: "(\uC544\uBB34\uB798\uB3C4 \uBC30\uAC00 \uB9CE\uC774 \uACE0\uD508 \uBAA8\uC591\uC774\uAD70.)"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - speaker: "\uD06C\uB9AC\uC2A4"
    text: "(\uC774\uB807\uAC8C \uD070 \uB0C4\uBE44\uBA74 \uC0D0\uB9AC\uC628\uC774
      \uBA39\uC744\uB9CC\uD07C\uB9CC \uD37C\uAC00\uB3C4 \uD2F0\uAC00 \uB098\uC9C4
      \uC54A\uC744\uD150\uB370... \uC5B4\uB5BB\uAC8C \uD558\uC9C0?)"
    choices:
    - choiceText: "\uC5B4\uCA54 \uC218 \uC5C6\uC9C0."
      nextDialogueIndex: 0
      choiceEvent:
        eventType: 1
        parameter: 
    - choiceText: "\uBB34\uC2DC\uD558\uACE0 \uC9C0\uB098\uAC04\uB2E4."
      nextDialogueIndex: 0
      choiceEvent:
        eventType: 1
        parameter: 
    lineEvent:
      eventType: 1
      parameter: 
  - speaker: "\uD06C\uB9AC\uC2A4"
    text: "\uC870\uAE08\uB9CC \uAC00\uC838\uAC00\uB294\uAC70\uC57C. \uC54C\uACA0\uC9C0?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - speaker: "\uC0D0\uB9AC\uC628"
    text: "\uC624\uC608!"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - speaker: "\uC0D0\uB9AC\uC628"
    text: "\uADF8\uB7F0\uB370 \uC694\uB9AC \uD560 \uC904\uC740 \uC54C\uC544?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - speaker: "\uD06C\uB9AC\uC2A4"
    text: "\uB0C4\uBE44 \uC606\uC5D0 \uB193\uC778 \uBC30\uB0AD\uC5D0 \uC7AC\uB8CC\uAC00
      \uC794\uB729 \uC788\uB2E4. \uC5B4\uB5A4\uAC78 \uBA3C\uC800 \uB123\uC5B4\uBCFC\uAE4C?"
    choices:
    - choiceText: "\uBB34"
      nextDialogueIndex: 0
      choiceEvent:
        eventType: 0
        parameter: 
    - choiceText: "\uB2F9\uADFC"
      nextDialogueIndex: 0
      choiceEvent:
        eventType: 0
        parameter: 
    lineEvent:
      eventType: 0
      parameter: 
  - speaker: "\uD06C\uB9AC\uC2A4"
    text: "\uC870\uAE08\uB9CC \uAC00\uC838\uAC00\uB294\uAC70\uC57C. \uC54C\uACA0\uC9C0?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - speaker: "\uD06C\uB9AC\uC2A4"
    text: "\uC870\uAE08\uB9CC \uAC00\uC838\uAC00\uB294\uAC70\uC57C. \uC54C\uACA0\uC9C0?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - speaker: "\uD06C\uB9AC\uC2A4"
    text: "\uC774 \uB140\uC11D\uC5D0\uAC8C \uD55C\uBC88 \uB9E1\uACA8\uBCF4\uC9C0."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - speaker: 
    text: "\uC554\uD751\uC694\uB9AC\uC0AC\uB294 \uC7AC\uB8CC\uB97C \uC120\uBCC4\uD558\uB354\uB2C8
      \uBE60\uB974\uAC8C \uC190\uC9C8\uD558\uACE0 \uB0C4\uBE44\uC5D0 \uC9D1\uC5B4\uB123\uC5C8\uB2E4."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  signalText: "\uD081\uD081... \uBB54\uAC00 \uB9DB\uC788\uB294 \uB0C4\uC0C8\uAC00
    \uB098. \uC5B4\uB514\uC11C \uB098\uB294 \uAC70\uC9C0?"
