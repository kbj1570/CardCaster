      parameter: 
  - mugShot: {fileID: -6382524348662822855, guid: f06b233c95fa86c4585f2e89c9a080a5, type: 3}
    speaker: 
    text: "\uADF8\uB0E5 \uBE48 \uC9D1\uC778\uAC00?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - mugShot: {fileID: 21300000, guid: dbf85913df6f05c4db3e9465472d66d5, type: 3}
    speaker: 
    text: "\uADF8\uB7F0 \uAC83 \uCE58\uACE0\uB294 \uBB38\uD328\uC5D0 \uBB54\uAC00
      \uC801\uD600\uC788\uB294\uB370."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - mugShot: {fileID: -6382524348662822855, guid: f06b233c95fa86c4585f2e89c9a080a5, type: 3}
    speaker: 
    text: "\uC5B4\uB514\uBCF4\uC790..."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - mugShot: {fileID: -6382524348662822855, guid: f06b233c95fa86c4585f2e89c9a080a5, type: 3}
    speaker: 
    text: "\"\uC5B8\uC81C \uC5B4\uB514\uC11C\uB4E0 \uBE60\uB974\uACE0 \uC815\uD655\uD558\uAC8C.\"
      \\r\\n \uC2E0\uC18D \uBC30\uB2EC \uC11C\uBE44\uC2A4?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - mugShot: {fileID: -6382524348662822855, guid: f06b233c95fa86c4585f2e89c9a080a5, type: 3}
    speaker: 
    text: "\"\uC9C0\uAE08\uC740 \uBC30\uB2EC \uC5C5\uBB34\uB85C \uC778\uD574 \uBD80\uC7AC\uC911\uC785\uB2C8\uB2E4.
      \uB098\uC911\uC5D0 \uB2E4\uC2DC \uCC3E\uC544\uC640\uC8FC\uC138\uC694.\""
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - mugShot: {fileID: 21300000, guid: dbf85913df6f05c4db3e9465472d66d5, type: 3}
    speaker: 
    text: "\uC774\uB7F0 \uC0C1\uD669\uC5D0\uC11C \uBC30\uB2EC\uC744 \uD55C\uB2E4\uACE0..?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - mugShot: {fileID: -6382524348662822855, guid: f06b233c95fa86c4585f2e89c9a080a5, type: 3}
    speaker: 
    text: "\uC77C\uB2E8\uC740 \uC544\uBB34\uB3C4 \uC5C6\uB294 \uAC83 \uAC19\uC73C\uB2C8.
      \\r\\n\uB2E4\uC74C\uC5D0 \uB2E4\uC2DC \uC640\uBCF4\uC790."
    choices: []
    lineEvent:
      eventType: 1
      parameter: 
