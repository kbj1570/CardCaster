      parameter: 
  - portrait: {fileID: 21300000, guid: dbf85913df6f05c4db3e9465472d66d5, type: 3}
    background: {fileID: 0}
    speaker: 
    text: "\uC544."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 21300000, guid: dbf85913df6f05c4db3e9465472d66d5, type: 3}
    background: {fileID: 0}
    speaker: 
    text: "\uC78A\uC5B4\uBC84\uB9AC\uACE0 \uC788\uC5C8\uB124."
    choices: []
    lineEvent:
      eventType: 13
      parameter: 
  - portrait: {fileID: -6382524348662822855, guid: f06b233c95fa86c4585f2e89c9a080a5, type: 3}
    background: {fileID: 0}
    speaker: ???
    text: "\uD734, \uC8FD\uB294\uC904 \uC54C\uC558\uB124."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 21300000, guid: dbf85913df6f05c4db3e9465472d66d5, type: 3}
    background: {fileID: 0}
    speaker: 
    text: "\uC7A0\uC740 \uC774\uC81C \uB2E4 \uC7A4\uB098\uBCF4\uC9C0?"
    choices: []
    lineEvent:
      eventType: 32
      parameter: 
  - portrait: {fileID: -6382524348662822855, guid: f06b233c95fa86c4585f2e89c9a080a5, type: 3}
    background: {fileID: 0}
    speaker: ???
    text: "\uC790\uAE34 \uB204\uAC00 \uC7A4\uB2E4\uACE0 \uADF8\uB798? "
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: -6382524348662822855, guid: f06b233c95fa86c4585f2e89c9a080a5, type: 3}
    background: {fileID: 0}
    speaker: ???
    text: "\uB0B4\uAC00 \uC124\uB9C8 \uC18D\uD3B8\uD558\uAC8C \uADF8\uB7EC\uACE0
      \uC788\uC5C8\uACA0\uC5B4?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 21300000, guid: dbf85913df6f05c4db3e9465472d66d5, type: 3}
    background: {fileID: 0}
    speaker: 
    text: "\uADF8\uB7F0 \uAC83\uCE58\uACE4 \uCF54\uACE0\uB294 \uC18C\uB9AC\uAC00\n\uC5EC\uAE30\uAE4C\uC9C0
      \uB4E4\uB9AC\uB358\uB370... \uC0D0\uB9AC\uC628."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: -6382524348662822855, guid: f06b233c95fa86c4585f2e89c9a080a5, type: 3}
    background: {fileID: 0}
    speaker: "\uC0D0\uB9AC\uC628"
    text: "\uD558\uC5EC\uAC04 \uADC0\uB294 \uC4F8\uB370\uC5C6\uC774 \uBC1D\uC544\uC694."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: -6382524348662822855, guid: f06b233c95fa86c4585f2e89c9a080a5, type: 3}
    background: {fileID: 0}
    speaker: "\uC0D0\uB9AC\uC628"
    text: "\uADF8\uB798\uC11C. \uBC8C\uC368 \uB3C4\uCC29\uD588\uC5B4?\n\uC5EC\uAE30\uAC00
      \uADF8 \uB9C8\uC744\uC774\uC57C?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
