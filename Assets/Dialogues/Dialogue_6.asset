  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: ???
    text: "\uBE68\uB9AC..."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: ???
    text: "\uAEBC\uB0B4\uC918..."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: ???
    text: "\uB098 \uC228\uB9C9\uD600!"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 21300000, guid: dbf85913df6f05c4db3e9465472d66d5, type: 3}
    background: {fileID: 0}
    speaker: 
    text: "\uC544."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 21300000, guid: dbf85913df6f05c4db3e9465472d66d5, type: 3}
    background: {fileID: 0}
    speaker: 
    text: "\uC78A\uC5B4\uBC84\uB9AC\uACE0 \uC788\uC5C8\uB124."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: -6382524348662822855, guid: f06b233c95fa86c4585f2e89c9a080a5, type: 3}
    background: {fileID: 0}
    speaker: ???
    text: "\uD734, \uC8FD\uB294\uC904 \uC54C\uC558\uB124."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 21300000, guid: dbf85913df6f05c4db3e9465472d66d5, type: 3}
    background: {fileID: 0}
    speaker: 
    text: "\uC7A0\uC740 \uC774\uC81C \uB2E4 \uC7A4\uB098\uBCF4\uC9C0?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: -6382524348662822855, guid: f06b233c95fa86c4585f2e89c9a080a5, type: 3}
    background: {fileID: 0}
    speaker: ???
    text: "\uC790\uAE34 \uB204\uAC00 \uC7A4\uB2E4\uACE0 \uADF8\uB798? "
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: -6382524348662822855, guid: f06b233c95fa86c4585f2e89c9a080a5, type: 3}
    background: {fileID: 0}
    speaker: ???
    text: "\uBB34\uC2A8 \uC77C\uC774 \uC0DD\uAE38\uC9C0 \uBAA8\uB974\uB2C8\uAE4C
      \uD56D\uC0C1 \uACBD\uACC4\uB97C \uD574\uC57C...."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 21300000, guid: dbf85913df6f05c4db3e9465472d66d5, type: 3}
    background: {fileID: 0}
    speaker: 
    text: "\uADF8\uB7F0 \uAC83\uCE58\uACE4 \uCF54\uACE0\uB294 \uC18C\uB9AC\uAC00\n\uC5EC\uAE30\uAE4C\uC9C0
      \uB4E4\uB9AC\uB358\uB370... \uC0D0\uB9AC\uC628."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: -6382524348662822855, guid: f06b233c95fa86c4585f2e89c9a080a5, type: 3}
    background: {fileID: 0}
    speaker: "\uC0D0\uB9AC\uC628"
    text: "\uD558\uC5EC\uAC04 \uC800 \uADC0\uB294 \uC4F8\uB370\uC5C6\uC774 \uBC1D\uC544\uC694."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: -6382524348662822855, guid: f06b233c95fa86c4585f2e89c9a080a5, type: 3}
    background: {fileID: 0}
    speaker: "\uC0D0\uB9AC\uC628"
    text: "\uADF8\uB798\uC11C. \uBC8C\uC368 \uB3C4\uCC29\uD588\uC5B4?\n\uC5EC\uAE30\uAC00
      \uADF8 \uB9C8\uC744\uC774\uC57C?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: 
    choices: []
    lineEvent:
      eventType: 23
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: ....
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: 
    choices: []
    lineEvent:
      eventType: 22
      parameter: 
  - portrait: {fileID: -6382524348662822855, guid: f06b233c95fa86c4585f2e89c9a080a5, type: 3}
    background: {fileID: 0}
    speaker: "\uC0D0\uB9AC\uC628"
    text: "\uC5B4\uB514\uC57C? \uC5EC\uAE34?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 21300000, guid: dbf85913df6f05c4db3e9465472d66d5, type: 3}
    background: {fileID: 0}
    speaker: 
    text: "\uB9CE\uC740 \uC77C\uC774 \uC788\uC5C8\uC9C0. \uB124\uAC00 \uD37C\uC9C8\uB7EC
      \uC790\uB294 \uB3D9\uC548\uC5D0."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: -6382524348662822855, guid: f06b233c95fa86c4585f2e89c9a080a5, type: 3}
    background: {fileID: 0}
    speaker: "\uC0D0\uB9AC\uC628"
    text: "\uBB50\uC57C? \uC124\uB9C8 \uC6B0\uB9AC\uB97C \uC774\uB7F0 \uACF3\uC5D0\n\uBC84\uB9AC\uACE0
      \uAC04\uAC70\uC57C?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 21300000, guid: dbf85913df6f05c4db3e9465472d66d5, type: 3}
    background: {fileID: 0}
    speaker: 
    text: "\uB9D0\uD558\uC790\uBA74 \uAE38\uC5B4\uC9C8\uAC83 \uAC19\uC73C\uB2C8 \uADF8
      \uC598\uAE30\uB294 \uC774\uC81C \uB410\uC5B4."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: -6382524348662822855, guid: f06b233c95fa86c4585f2e89c9a080a5, type: 3}
    background: {fileID: 0}
    speaker: "\uC0D0\uB9AC\uC628"
    text: "\uD55C\uBC24\uC911\uC5D0 \uC774\uB807\uAC8C \uC73C\uC2A4\uC2A4\uD55C \uC232\uC744\n\uC9C0\uB098\uAC00\uC57C
      \uD55C\uB2E4\uB2C8..."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: -6382524348662822855, guid: f06b233c95fa86c4585f2e89c9a080a5, type: 3}
    background: {fileID: 0}
    speaker: "\uC0D0\uB9AC\uC628"
    text: "\uC644\uC804 \uCD5C\uC545\uC774\uC57C..."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 21300000, guid: dbf85913df6f05c4db3e9465472d66d5, type: 3}
    background: {fileID: 0}
    speaker: 
    text: "\uC774\uAC8C \uB2E4 \uB204\uAD6C \uB54C\uBB38\uC778\uC9C0 \uC78A\uC5B4\uBC84\uB838\uB098?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 21300000, guid: dbf85913df6f05c4db3e9465472d66d5, type: 3}
    background: {fileID: 0}
    speaker: 
    text: "\uB124\uAC00 \uC7A5\uAC70\uB9AC \uC6CC\uD504\uB97C \uD574\uBCF4\uACE0
      \uC2F6\uB2E4\uACE0\n\uC878\uB77C\uB300\uC9C0\uB9CC \uC54A\uC558\uC5B4\uB3C4"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 21300000, guid: dbf85913df6f05c4db3e9465472d66d5, type: 3}
    background: {fileID: 0}
    speaker: 
    text: "\uC9C4\uC791\uC5D0 \uB3C4\uCC29\uD558\uACE0\uB3C4 \uB0A8\uC558\uC744\uAC78."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: -6382524348662822855, guid: f06b233c95fa86c4585f2e89c9a080a5, type: 3}
    background: {fileID: 0}
    speaker: "\uC0D0\uB9AC\uC628"
    text: "\uB098\uB294 \uB108\uB97C \uB3C4\uC640\uC8FC\uB824\uACE0 \uD55C \uAC70\uC600\uB2E4\uACE0."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: -6382524348662822855, guid: f06b233c95fa86c4585f2e89c9a080a5, type: 3}
    background: {fileID: 0}
    speaker: "\uC0D0\uB9AC\uC628"
    text: "\uADF8\uB7F0\uB370 \uC774\uC0C1\uD558\uB124...\n\uBD84\uBA85\uD788 \uC9C0\uB3C4\uB791
      \uB098\uCE68\uBC18\uC744 \uBCF4\uACE0 \uC6CC\uD504\uB97C \uD55C\uAC74\uB370.
      \uBB50\uAC00 \uBB38\uC81C\uC600\uC9C0?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 21300000, guid: dbf85913df6f05c4db3e9465472d66d5, type: 3}
    background: {fileID: 0}
    speaker: 
    text: "\uBD84\uBA85 \uADF8\uB7AC\uC9C0."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 21300000, guid: dbf85913df6f05c4db3e9465472d66d5, type: 3}
    background: {fileID: 0}
    speaker: 
    text: "\uB124\uAC00 \uBE68\uAC04\uBC14\uB298\uC774 \uB0A8\uCABD\uC774\uB77C\uACE0
      \uC54C\uACE0 \uC788\uB2E4\uB294\uAC78 \uB0B4\uAC00 \uBBF8\uB9AC \uB208\uCE58\uCC58\uC5B4\uC57C
      \uD588\uB294\uB370."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: -6382524348662822855, guid: f06b233c95fa86c4585f2e89c9a080a5, type: 3}
    background: {fileID: 0}
    speaker: 
    text: "\uC544\uD508 \uACF3\uC744 \uCC0C\uB974\uB294\uAD6C\uB9CC..."
    choices: []
    lineEvent:
      eventType: 1
      parameter: 
