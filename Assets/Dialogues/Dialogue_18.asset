--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 63270e1dec17bfc4a99b21cf610bba98, type: 3}
  m_Name: Dialogue_18
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uC544.. \uC624\uC168\uAD70\uC694."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uC880 \uC804\uC5D0 \uC774\uC57C\uAE30\uB97C \uB4E4\uC5C8\uC2B5\uB2C8\uB2E4."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uB808\uC624\uAC00 \uBB34\uC0AC\uD788 \uB3CC\uC544\uC654\uB2E4\uACE0..."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uC6D0\uB798\uB294 \uC800\uD76C\uAC00 \uD588\uC5B4\uC57C \uD558\uB294\n\uC77C\uC778\uB370.
      \uBA74\uBAA9\uC774\uC5C6\uAD70\uC694."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uADF8\uB7F0 \uC77C\uC744 \uBABB\uBCF8\uCCB4\uD558\uACE0 \uC9C0\uB098\uAC00\uB294\n\uC131\uACA9\uC740
      \uC544\uB2C8\uB77C\uC11C \uB9D0\uC774\uC9C0."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uBCF4\uB2F5\uC774\uB77C\uACE0 \uD558\uAE30\uC5D4 \uBB50\uD558\uC9C0\uB9CC\n\uC774\uAC70\uB77C\uB3C4
      \uBC1B\uC544\uC8FC\uC138\uC694."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "1000\uACE8\uB4DC\uB97C \uD68D\uB4DD\uD588\uB2E4."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uADF8\uB7EC\uACE0\uBCF4\uB2C8 \uC544\uAE4C\uB294 \uC5EC\uCB64\uBCFC\uAC8C\n\uC788\uB2E4\uACE0..."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uADF8\uB798. \uCC3E\uACE0 \uC788\uB294 \uC0AC\uB78C\uC774 \uC788\uB2E4.\n\uC544\uB294
      \uAC74 \uC774\uB984 \uBFD0\uC774\uC9C0\uB9CC."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uB77C\uB514\uC548\uC774\uB77C\uB294 \uC0AC\uB78C\uC778\uB370."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uB77C\uB514\uC548?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uD639\uC2DC \uB4E4\uC5B4\uBCF8 \uC801 \uC5C6\uC5B4?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uC5EC\uAE30 \uC0DD\uC874\uC790 \uC911\uC5D0\uC11C \uC788\uB2E4\uB4E0\uAC00.\n\uC544\uB2C8\uBA74
      \uB9C8\uC744 \uC8FC\uBBFC \uC911 \uD558\uB098\uB77C\uB4E0\uAC00."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uAE00\uC384\uC694. \uC774\uB807\uAC8C \uBCF4\uC5EC\uB3C4 \uC800\uB294\n\uBC14\uC774\uB8EC\uC5D0
      \uC628\uC9C0 \uC5BC\uB9C8 \uC548\uB41C\uC9C0\uB77C."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uC5EC\uAE30 \uACC4\uC2E0 \uBD84\uB4E4 \uC911\uC5D0\uC11C\n\uADF8\uB7F0
      \uC774\uB984\uC740 \uC5C6\uC5C8\uB358 \uAC19\uC544\uC694."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uC218\uD655\uC774 \uC5C6\uB294 \uAC74\uAC00.."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uADF8 \uC758\uB8B0\uB294 \uAD6C\uC870 \uC694\uCCAD\uC774\uC5C8\uB098\uC694?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uADF8\uB807\uB2E4\uACE0 \uBCFC \uC218 \uC788\uC9C0."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uB9C8\uC744 \uBC16\uC73C\uB85C \uBB34\uC0AC\uD788 \uB370\uB824\uB2E4\n\uB2EC\uB77C\uACE0
      \uD588\uC73C\uB2C8."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uC800\uD76C\uAC00 \uBCF4\uB0B8 \uAD6C\uC870 \uC694\uCCAD\uC740 \uC544\uB2C8\uC5C8\uB098\uBCF4\uB124\uC694."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uD639\uC2DC \uAD6C\uC870 \uC694\uCCAD\uC744 \uBCF4\uB0B8\uC9C0\uB294
      \uC5BC\uB9C8\uB098\n\uB410\uC9C0?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uC544\uB9C8.. \uC774\uD2C0 \uC804 \uC77C\uAC70\uC5D0\uC694."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uC774\uD2C0\uBC16\uC5D0 \uC548\uB410\uB2E4\uACE0?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uB124. \uAC11\uC790\uAE30 \uAD34\uBB3C\uB4E4\uC774 \uB098\uD0C0\uB098\uACE0\n\uC9C0\uC9C4\uB54C\uBB38\uC5D0
      \uAC74\uBB3C\uB4E4\uC774 \uBB34\uB108\uC9C0\uACE0.."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uC0AC\uD0DC\uAC00 \uC77C\uC5B4\uB09C\uC9C0\uB294 \uC544\uC9C1\n\uC774\uD2C0
      \uBC16\uC5D0 \uB418\uC9C0 \uC54A\uC558\uC5B4\uC694."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uC544\uC9C1 \uC6D0\uC778\uB3C4 \uC81C\uB300\uB85C \uD30C\uC545\uD558\uC9C0
      \uBABB\uD574\uC11C\n\uBAA8\uB450\uB4E4 \uB108\uBB34 \uB2F5\uB2F5\uD55C \uC2EC\uC815\uC785\uB2C8\uB2E4."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uC544\uBB34\uD2BC \uB3C4\uC6C0\uC774 \uB418\uC9C0 \uBABB\uD574\uC11C\n\uC8C4\uC1A1\uD569\uB2C8\uB2E4."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uAD1C\uCC2E\uC544. \uC5B4\uCA54 \uC218 \uC5C6\uB294\uAC70\uC9C0.\n\uC6B0\uB9AC\uB07C\uB9AC
      \uCC3E\uC544\uBCFC\uAC8C!"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uB124.. \uADF8\uB7EC\uBA74 \uC800\uB294 \uC774\uB9CC\n\uC778\uC6D0 \uC810\uAC80\uC744
      \uD558\uB7EC..."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: ......
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uC774\uD2C0\uC774\uB77C\uACE0 \uD588\uC9C0.\n\uBC29\uAE08?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uC774\uC0C1\uD574..."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uBD84\uBA85\uD788 \uC6B0\uB9AC\uAC00 \uC774 \uC758\uB8B0\uB97C \uBC1B\uC740
      \uAC74."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "5\uC77C \uC804\uC778\uB370... \uB9D0\uC774\uC9C0."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uADF8\uB7FC \uC774 \uAD6C\uC870 \uC694\uCCAD\uC758 \uC774\uC720\uAC00\n\uC774
      \uAD34\uBB3C\uB4E4 \uB54C\uBB38\uC774 \uC544\uB2C8\uC5C8\uB2E8 \uB9D0\uC774\uC57C?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uB3C4\uBB34\uC9C0 \uC601\uBB38\uC744 \uBAA8\uB974\uACA0\uAD70."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uC774\uC820 \uC5EC\uAE30\uC5D0 \uAE30\uB300\uBCF4\uB294 \uC218 \uBC16\uC5D0
      \uC5C6\uB098."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uC758\uB8B0\uC5D0 \uB098\uC628 \uC811\uC120\uC7A5\uC18C \uB9D0\uC774\uC9C0?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uC5B4\uB514\uBCF4\uC790...\n\uACF5\uB3D9\uBB18\uC9C0 \uC600\uC5C8\uB098?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uB85C\uB128\uC5D0\uAC8C \uBC1B\uC740 \uC9C0\uB3C4\uB97C\n\uAEBC\uB0B4\uBCF4\uC790."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uC6B0\uB9AC\uB294 \uC5EC\uAE30\uC5D0 \uC788\uC5B4."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uADF8\uB9AC\uACE0 \uACF5\uB3D9\uBB18\uC9C0\uB294 \uC5EC\uAE30."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uADF8\uB7F0\uB370 \uAF64 \uB113\uC5B4\uBCF4\uC774\uB294\uB370\n\uB300\uCCB4
      \uC5EC\uAE30 \uC5B4\uB514\uC5D0 \uC788\uB2E4\uB294 \uAC78\uAE4C?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uC77C\uB2E8 \uAC00\uBCF4\uBA74 \uBB50\uB4E0\n\uC54C \uC218 \uC788\uACD8\uC9C0."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uACB0\uAD6D\uC5D4 \uB9E8\uB545\uC5D0 \uD5E4\uB529\uC774\uAD6C\uB9CC..."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uD558\uAE34 \uC6B0\uB9AC\uAC00 \uB298 \uC774\uB7F0 \uC2DD\uC774\uC9C0
      \uBB50."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
