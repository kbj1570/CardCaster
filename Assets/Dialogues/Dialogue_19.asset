  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 63270e1dec17bfc4a99b21cf610bba98, type: 3}
  m_Name: Dialogue_19
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uC5EC\uAE30\uB85C\uAD70. \uACF5\uB3D9\uBB18\uC9C0."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uD55C \uBC24\uC911\uC5D0 \uACF5\uB3D9\uBB18\uC9C0\uB77C\uB2C8..."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uBB34\uC11C\uC6B0\uBA74 \uADF8\uB0E5 \uB098 \uD63C\uC790 \uAC00\uB3C4\n\uB418\uB294\uB370?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uADF8\uB7F4 \uC21C \uC5C6\uC9C0! \uB098\uB3C4 \uAC08 \uAC70\uC57C!"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uD558\uC5EC\uAC04 \uACE0\uC9D1\uC740 \uC54C\uC544\uC918\uC57C\n\uD55C\uB2E4\uB2C8\uAE4C."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uADF8\uB7F0\uB370 \uAC11\uC790\uAE30 \uB4E0 \uC0DD\uAC01\uC778\uB370."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uADF8\uB0E5 \uC5B4\uCC28\uD53C \uC5EC\uAE30 \uC62C \uAC70\uC600\uC73C\uBA74"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uCC98\uC74C\uBD80\uD130 \uACF5\uB3D9\uBB18\uC9C0\uB85C \uAC00\uBA74\n\uB410\uB358\uAC70
      \uC544\uB2C8\uC57C?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uC6D0\uB798\uB77C\uBA74 \uADF8\uB807\uAC8C \uD588\uACA0\uC9C0\uB9CC..."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uB3C4\uCC29\uD558\uC790\uB9C8\uC790 \uC774\uB7F0 \uB09C\uC7A5\uD310\uC744
      \uBCF4\uB2C8\n\uADF8\uB7F0 \uC0DD\uAC01\uC774 \uC804\uD600 \uC548\uB4E4\uB354\uAD70."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uADF8\uB7F4\uB9CC\uB3C4 \uD558\uB124."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uC7A1\uB2F4\uC740 \uADF8\uB9CC\uD558\uACE0\n\uC5B4\uC11C \uB4E4\uC5B4\uAC00\uBCF4\uC790."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
