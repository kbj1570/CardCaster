  m_Script: {fileID: 11500000, guid: 63270e1dec17bfc4a99b21cf610bba98, type: 3}
  m_Name: Dialogue_12
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uC5EC\uAE30\uC778\uAC00?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uB2E4\uB4E4 \uC5EC\uAE30\uC5D0 \uC228\uC5B4\uC788\uC5C8\uAD6C\uB098."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uCC3E\uACE0 \uACC4\uC2E0 \uBD84\uC774 \uB204\uAD70\uC9C0\uB294\n\uBAA8\uB974\uACA0\uC9C0\uB9CC"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uC9C0\uAE08 \uC57C\uC601\uC9C0\uB97C \uD1B5\uC194\uD558\uB294 \uBD84\uC740\n\uB85C\uB12C\uB2D8\uC785\uB2C8\uB2E4."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uADF8 \uBD84\uC774\uB77C\uBA74 \uBB50\uB77C\uB3C4 \uC54C\uACE0\uACC4\uC2DC\uACA0\uC8E0."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uC9C0\uAE08\uCBE4\uC774\uBA74 \uC800\uAE30 \uBCF4\uC774\uB294 \uD070
      \uD150\uD2B8\uC548\uC5D0\n\uACC4\uC2E4\uAC81\uB2C8\uB2E4."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uC9C0\uAE08\uCBE4\uC774\uBA74 \uC800\uAE30 \uBCF4\uC774\uB294 \uD070
      \uD150\uD2B8\uC548\uC5D0\n\uACC4\uC2E4\uAC81\uB2C8\uB2E4."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uC54C\uB824\uC918\uC11C \uACE0\uB9C8\uC6CC!"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uBCC4 \uB9D0\uC500\uC744\uC694."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uC800\uB294 \uC774\uB9CC \uAC00\uBCF4\uACA0\uC2B5\uB2C8\uB2E4!\n"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uB2E4\uC74C\uBD80\uD134 \uBC16\uC5D0 \uB098\uAC08\uB550 \uC870\uC2EC\uD574!\n"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uAC00\uBC84\uB838\uB124."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uADF8\uAC74 \uADF8\uB807\uACE0..."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uC6B0\uB9AC\uAC00 \uCC3E\uB294 \uADF8 \uC5EC\uC790\uAC00\n\uC815\uB9D0
      \uC5EC\uAE30\uC5D0 \uC788\uC744\uAE4C?"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uADF8\uB807\uB2E4\uBA74 \uC598\uAE30\uAC00 \uBE60\uB974\uACA0\uC9C0\uB9CC..."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uC77C\uB2E8 \uADF8 \uB85C\uB12C\uC778\uAC00 \uD558\uB294 \uC0AC\uB78C\uC744\n\uBA3C\uC800
      \uB9CC\uB098\uBCF4\uB294\uAC8C \uC88B\uACA0\uC5B4."
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
  - portrait: {fileID: 0}
    background: {fileID: 0}
    speaker: 
    text: "\uADF8\uB798. \uAC00\uC7A5 \uD070 \uD150\uD2B8\uC5D0 \uC788\uB2E4\uACE0
      \uD588\uC9C0?\n\uD55C\uBC88 \uAC00\uBCF4\uC790!"
    choices: []
    lineEvent:
      eventType: 0
      parameter: 
